{
	"name": "pkg-size",
	"version": "0.0.0-semantic-release",
	"description": "Measure the size of your npm package distribution",
	"keywords": [
		"cli",
		"pkg-size",
		"package",
		"distribution",
		"size",
		"npm"
	],
	"license": "MIT",
	"repository": "privatenumber/pkg-size",
	"funding": "https://github.com/privatenumber/pkg-size?sponsor=1",
	"packageManager": "pnpm@10.24.0",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"main": "dist/index.js",
	"bin": "dist/cli.js",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"scripts": {
		"build": "pkgroll --minify --clean-dist",
		"lint": "lintroll --cache",
		"test": "tsx tests",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"devDependencies": {
		"@types/glob-to-regexp": "^0.4.1",
		"@types/tar": "^4.0.5",
		"brotli-size": "^4.0.0",
		"byte-size": "^7.0.0",
		"cac": "^6.7.3",
		"clean-pkg-json": "^1.3.0",
		"cli-simple-table": "^1.1.0",
		"colorette": "^1.2.2",
		"fs-fixture": "^2.11.0",
		"glob-to-regexp": "^0.4.1",
		"gzip-size": "^6.0.0",
		"lintroll": "^1.25.0",
		"manten": "^1.9.0",
		"npm-packlist": "^2.2.2",
		"p-map": "^5.1.0",
		"pkgroll": "^2.21.4",
		"tar-fs": "^2.1.1",
		"tsx": "^4.21.0",
		"typescript": "^4.3.5"
	}
}
