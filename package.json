{
	"name": "pkg-size",
	"version": "0.0.0-semantic-release",
	"description": "Measure the size of your npm package distribution",
	"keywords": [
		"cli",
		"pkg-size",
		"package",
		"distribution",
		"size",
		"npm"
	],
	"license": "MIT",
	"repository": "privatenumber/pkg-size",
	"funding": "https://github.com/privatenumber/pkg-size?sponsor=1",
	"author": {
		"name": "Hiroki Osame",
		"email": "hiroki.osame@gmail.com"
	},
	"files": [
		"dist"
	],
	"bin": "dist/cli/index.js",
	"main": "dist/index.js",
	"exports": {
		".": {
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			},
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			}
		}
	},
	"packageManager": "pnpm@10.24.0",
	"scripts": {
		"build": "pkgroll --minify --clean-dist",
		"lint": "lintroll --cache",
		"test": "tsx tests",
		"type-check": "tsc",
		"prepack": "pnpm build && clean-pkg-json"
	},
	"engines": {
		"node": ">=20.19.0"
	},
	"dependencies": {
		"cleye": "^2.1.0",
		"yoctocolors": "^2.1.2",
		"zstd-napi": "^0.0.12"
	},
	"devDependencies": {
		"@types/byte-size": "^8.1.2",
		"@types/glob-to-regexp": "^0.4.1",
		"@types/npm-packlist": "^7.0.3",
		"@types/tar": "^6.1.13",
		"@types/tar-fs": "^2.0.4",
		"brotli-size": "^4.0.0",
		"byte-size": "^9.0.1",
		"clean-pkg-json": "^1.3.0",
		"cli-simple-table": "^1.1.0",
		"fs-fixture": "^2.11.0",
		"get-node": "^14.2.1",
		"glob-to-regexp": "^0.4.1",
		"gzip-size": "^7.0.0",
		"lintroll": "^1.25.0",
		"manten": "^1.9.0",
		"nano-spawn": "^2.0.0",
		"npm-packlist": "^10.0.3",
		"p-map": "^7.0.4",
		"pkgroll": "^2.21.4",
		"tar-fs": "^3.1.1",
		"tsx": "^4.21.0",
		"typescript": "^5.9.3"
	}
}
